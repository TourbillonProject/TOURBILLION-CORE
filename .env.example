# Copy to .env and fill in. Every variable is optional unless marked REQUIRED.
# Full reference: docs/ENVIRONMENT.md

# --- Server -----------------------------------------------------------------
TC_PORT=8787
# Public HTTPS address the iPad uses. REQUIRED for Gmail OAuth; recommended always.
TC_PUBLIC_URL=https://tourbillion.your-domain.example
# Set to true when behind a reverse proxy that sets X-Forwarded-Proto/Host (Caddy, nginx, Tailscale Serve).
TC_TRUST_PROXY=true
TC_DATA_DIR=./data
TC_OWNER_NAME=Keenan
# 32 random bytes, base64 (openssl rand -base64 32). If unset, a key is generated in TC_DATA_DIR/master.key.
TC_MASTER_KEY=

# --- Claude (Anthropic API) -------------------------------------------------
# Optional here: you can also paste the key in Connected Apps (stored encrypted).
TC_ANTHROPIC_API_KEY=
TC_ANTHROPIC_MODEL=claude-opus-5-5

# --- Gmail (Google OAuth client, type "Web application") ---------------------
TC_GOOGLE_CLIENT_ID=
TC_GOOGLE_CLIENT_SECRET=

# --- Search & research ------------------------------------------------------
TC_SEARXNG_URL=
TC_BRAVE_SEARCH_KEY=
TC_YOUTUBE_API_KEY=
TC_GITHUB_TOKEN=

# --- Remote browser ---------------------------------------------------------
TC_BROWSER_ENABLED=true
TC_BROWSER_MAX_TABS=6

# --- Spider -----------------------------------------------------------------
# Comma-separated server folders that may be registered as projects.
TC_PROJECT_ROOTS=
